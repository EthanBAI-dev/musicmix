# === 数据：绝不入库 ===
# MTG-Jamendo 的音频是 CC 授权曲目、元数据 CC BY-NC-SA 4.0 仅限非商业研究，
# 不可再分发。元数据 tsv 也不入库（几十 MB，且 download_jamendo.py 能重新拉）。
data/
!data/.gitkeep
*.wav
*.flac
*.mp3
*.ogg
*.m4a
*.stem.mp4
*.npy
*.npz

# 例外：单元测试用的极小固定资产
!tests/assets/**

# 例外：前端演示音频。**脚本合成的**，不涉及任何数据集版权，约 2MB，
# 随 `python -m scripts.make_demo_stems` 重新生成。
!web/demo/**

# 反例外：失败案例音频**不入库**。它们是 MUSDB18-HQ 的 30 秒片段，
# 而该数据集是非商业研究许可、不可再分发。manifest.json 只有元数据，可以入库。
# 本地重新生成：`python -m scripts.export_failure_cases`
web/cases/**
!web/cases/manifest.json

# 用户自己上传分离的曲目：是他人的版权音乐，绝不入库
web/mine/**
data/_uploads/**

# === 模型权重 ===
checkpoints/
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors

# === 实验产物 ===
runs/
wandb/
lightning_logs/
outputs/
.cache/
*.log

# results/ 是作品集本体，必须入库；但里面的音频片段和大图除外
results/**/*.wav
results/**/*.mp3

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# === 环境 ===
.venv/
venv/
.env
.python-version

# === 前端 ===
node_modules/
web/dist/
web/.vite/
# OpenAI Sites 的独立部署工程，含托管项目标识，不属于本地版
site/

# === 系统 ===
.DS_Store
Thumbs.db
.idea/
.vscode/
